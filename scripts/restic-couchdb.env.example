# Copy to a secure path on VPS (recommended: /root/.restic-couchdb.env)
# Then chmod 600 that file.

# Restic backend target (S3-compatible example):
# RESTIC_REPOSITORY="s3:https://s3.eu-west-3.amazonaws.com/your-bucket/cozy-couchdb"
RESTIC_REPOSITORY=""

# Restic encryption password (long random value)
RESTIC_PASSWORD=""

# S3-compatible credentials
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional for non-AWS S3 providers:
# AWS_DEFAULT_REGION="eu-west-3"
# AWS_ENDPOINT_URL="https://s3.eu-west-3.amazonaws.com"
